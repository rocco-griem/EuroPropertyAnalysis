# Copy this file to `.env` and adjust if you want to override defaults.
# `.env` is gitignored. All values below are OPTIONAL — the project runs with defaults.

# Database connection URL (SQLAlchemy format).
# Default (if unset): sqlite:///data/database/europropertyanalysis.db
# Switching to PostgreSQL later only requires changing this URL, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/europropertyanalysis
# DATABASE_URL=sqlite:///data/database/europropertyanalysis.db
